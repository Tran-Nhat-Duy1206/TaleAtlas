{
  "name": "taleatlas",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @taleatlas/web dev",
    "build": "pnpm --filter @taleatlas/web build",
    "start": "pnpm --filter @taleatlas/web start",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.tests.json",
    "lint": "pnpm --filter @taleatlas/web lint",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "node --import tsx ./node_modules/@playwright/test/cli.js test",
    "db:generate": "pnpm --filter @taleatlas/database generate",
    "db:migrate": "pnpm --filter @taleatlas/database migrate"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/smtp-server": "^3.5.12",
    "embedded-postgres": "18.4.0-beta.17",
    "jsdom": "^28.0.0",
    "prettier": "3.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "smtp-server": "^3.18.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "zod": "^4.6.5"
  }
}
