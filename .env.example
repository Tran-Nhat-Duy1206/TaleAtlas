# Example placeholders only. Never commit real .env/.env.local files.
# Node 24 / pnpm 11.7.0. Export root CLI variables explicitly;
# Next development can read apps/web/.env.local.
APP_ORIGIN=http://localhost:3000
# Generate a private cryptographically random value of at least 32 characters.
BETTER_AUTH_SECRET=replace-with-a-private-random-secret-at-least-32-characters

# Runtime: Neon pooled connection in deployment; isolated local DB in development.
DATABASE_URL=postgresql://taleatlas:replace-local-password@localhost:5432/taleatlas
# Explicit migration tooling prefers this direct URL, falling back to DATABASE_URL.
# Neon deployment: direct, non-pooler connection with sslmode=verify-full (or provider-supported sslrootcert=system).
DATABASE_URL_DIRECT=postgresql://taleatlas:replace-local-password@localhost:5432/taleatlas

# Local SMTP capture service; do not assume one is started by the app.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=TaleAtlas <noreply@localhost>
# Set both fields together when authentication is required; otherwise omit both.
# SMTP_USER=replace-smtp-user
# SMTP_PASSWORD=replace-smtp-password

# Production: HTTPS APP_ORIGIN, private Better Auth secret, verified sender,
# authenticated SMTP and TLS (465/secure=true or provider STARTTLS configuration).
# No GitHub OAuth, Vercel token, Neon API key or metadata-provider key is included.
